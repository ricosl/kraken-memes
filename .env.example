# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DATABASE_URL=postgres://kraken_memes:kraken_memes@localhost:5432/kraken_memes

# --- Server ---
SERVER_PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Web Push / VAPID ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Kraken ---
KRAKEN_REST_BASE_URL=https://api.kraken.com
KRAKEN_WS_URL=wss://ws.kraken.com/v2
KRAKEN_QUOTE_ASSET=USD

# --- Social signal provider (V1 ships with none configured; system must work without it) ---
SOCIAL_PROVIDER=none
# LUNARCRUSH_API_KEY=

# --- Worker ---
WORKER_SCAN_INTERVAL_MINUTES=15
WORKER_LOG_LEVEL=info
